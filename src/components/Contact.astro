---
import ScrollFadeIn from './ScrollFadeIn.astro';
---

<section id="contact" class="py-24 lg:py-32">
  <div class="max-w-2xl mx-auto px-6">
    <ScrollFadeIn>
      <div class="text-center mb-12">
        <p class="text-gold text-sm tracking-[0.25em] uppercase mb-3">Обратная связь</p>
        <h2 class="text-4xl lg:text-5xl font-light text-charcoal">Связаться с автором</h2>
        <div class="w-12 h-px bg-gold mx-auto mt-6"></div>
      </div>
    </ScrollFadeIn>

    <ScrollFadeIn>
      <div class="bg-ivory border border-gold/20 p-8 md:p-12 shadow-sm">
        <form id="contact-form" class="space-y-6">
          <div>
            <label for="contact-name" class="block text-sm font-medium text-charcoal mb-2 tracking-wide">
              Имя
            </label>
            <input
              type="text"
              id="contact-name"
              name="name"
              required
              placeholder="Ваше имя"
              class="w-full px-4 py-3 bg-ivory-dark/40 border border-gold/20 rounded-none text-charcoal placeholder-charcoal-light/50 focus:outline-none focus:border-gold transition-colors duration-300"
            />
          </div>

          <div>
            <label for="contact-email" class="block text-sm font-medium text-charcoal mb-2 tracking-wide">
              Email
            </label>
            <input
              type="email"
              id="contact-email"
              name="email"
              required
              placeholder="example@email.com"
              class="w-full px-4 py-3 bg-ivory-dark/40 border border-gold/20 rounded-none text-charcoal placeholder-charcoal-light/50 focus:outline-none focus:border-gold transition-colors duration-300"
            />
          </div>

          <div>
            <label for="contact-phone" class="block text-sm font-medium text-charcoal mb-2 tracking-wide">
              Номер телефона
            </label>
            <input
              type="tel"
              id="contact-phone"
              name="phone"
              placeholder="+7 (___) ___-__-__"
              class="w-full px-4 py-3 bg-ivory-dark/40 border border-gold/20 rounded-none text-charcoal placeholder-charcoal-light/50 focus:outline-none focus:border-gold transition-colors duration-300"
            />
          </div>

          <div>
            <label for="contact-message" class="block text-sm font-medium text-charcoal mb-2 tracking-wide">
              Текст сообщения
            </label>
            <textarea
              id="contact-message"
              name="message"
              rows="5"
              required
              placeholder="Напишите ваше сообщение..."
              class="w-full px-4 py-3 bg-ivory-dark/40 border border-gold/20 rounded-none text-charcoal placeholder-charcoal-light/50 focus:outline-none focus:border-gold transition-colors duration-300 resize-y"
            ></textarea>
          </div>

          <div id="contact-success-msg" class="hidden p-4 bg-gold/10 border border-gold/30 text-charcoal text-center text-lg">
            Спасибо! Ваше сообщение успешно отправлено.
          </div>

          <button
            type="submit"
            id="contact-submit-btn"
            class="w-full py-4 bg-gold hover:bg-gold-dark text-ivory font-medium tracking-widest uppercase transition-colors duration-300 disabled:opacity-50 cursor-pointer"
          >
            Отправить
          </button>
        </form>
      </div>
    </ScrollFadeIn>
  </div>
</section>

<script>
  const form = document.getElementById('contact-form') as HTMLFormElement | null;
  const submitBtn = document.getElementById('contact-submit-btn') as HTMLButtonElement | null;
  const successMsg = document.getElementById('contact-success-msg') as HTMLDivElement | null;

  form?.addEventListener('submit', async (e) => {
    e.preventDefault();

    if (!submitBtn || !successMsg) return;

    // Hide previous success message if any
    successMsg.classList.add('hidden');

    // Show loading state
    const originalText = submitBtn.textContent;
    submitBtn.disabled = true;
    submitBtn.textContent = 'Отправка...';

    // Simulate backend submission delay
    await new Promise((resolve) => setTimeout(resolve, 1000));

    // Reset button state
    submitBtn.disabled = false;
    submitBtn.textContent = originalText;

    // Reset form fields
    form.reset();

    // Show success message
    successMsg.classList.remove('hidden');
  });
</script>
