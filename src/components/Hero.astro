---
---

<section class="min-h-screen flex flex-col lg:flex-row">
  <!-- Photo side -->
  <div class="lg:w-1/2 h-[50vh] lg:h-screen relative overflow-hidden">
    <img
      src="/images/hero.png"
      alt="Анастасия Кудинова"
      class="w-full h-full object-cover object-center"
      loading="eager"
    />
    <div class="absolute inset-0 bg-gradient-to-t from-ivory/20 to-transparent lg:bg-gradient-to-r lg:from-transparent lg:to-ivory/10"></div>
  </div>

  <!-- Text side -->
  <div class="lg:w-1/2 flex items-center justify-center px-8 py-16 lg:py-0">
    <div class="max-w-md text-center lg:text-left">
      <p class="text-gold text-lg tracking-[0.25em] uppercase mb-4">Поэтесса</p>
      <h1 class="text-5xl sm:text-6xl lg:text-7xl font-light text-charcoal leading-tight mb-6">
        Анастасия<br />
        <span class="font-semibold">Кудинова</span>
      </h1>
      <div class="w-16 h-px bg-gold mx-auto lg:mx-0 mb-6"></div>
      <p class="text-xl text-charcoal-light leading-relaxed italic">
        «Куколка»
      </p>
      <a
        href="#poems"
        class="inline-block mt-10 px-8 py-3 border border-gold text-gold hover:bg-gold hover:text-ivory transition-all duration-300 tracking-wider uppercase text-sm"
      >
        Читать стихи
      </a>
    </div>
  </div>
</section>
